{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "modules-left": [
    "image#logo",
    "niri/workspaces",
    "custom/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "image#media",
    "group/volume",
    "image#network",
    "image#clipboard",
    "image#wallpaper",
    "image#settings",
    "group/battery",
    "image#power"
  ],
  "reload_style_on_change": true,

  "image#logo": {
    "path": "/home/me/niri-setup/waybar/icons/logo.svg",
    "size": 15,
    "interval": 60,
    "tooltip": false,
    "on-click": "fuzzel --config /home/me/niri-setup/fuzzel/fuzzel.ini"
  },

  "niri/workspaces": {
    "format": "{index}",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,
    "active-only": false
  },

  "custom/window": {
    "format": "{}",
    "interval": 1,
    "exec": "python3 /home/me/niri-setup/waybar/modules/window_info.py",
    "return-type": "json"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<b>{:%A, %d %B %Y}</b>\n{:%H:%M:%S}\n\n{calendar}\n<span color='#7C8A6A' size='small'>Click: floating calendar · Scroll: change month</span>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#FF8B4A'><b>{}</b></span>",
        "days": "<span color='#F7C7A1'><b>{}</b></span>",
        "weekdays": "<span color='#E85D2F'><b>{}</b></span>",
        "today": "<span color='#000000' background='#E85D2F'><b> {} </b></span>"
      }
    },
    "on-click": "/home/me/niri-setup/waybar/scripts/calendar.sh",
    "actions": {
      "on-click-middle": "mode",
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "image#media": {
    "exec": "/home/me/niri-setup/waybar/scripts/media-icon.sh",
    "size": 14,
    "interval": 2,
    "on-click": "/home/me/niri-setup/waybar/scripts/media-menu.sh",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "group/volume": {
    "orientation": "horizontal",
    "modules": [
      "image#volume",
      "pulseaudio"
    ]
  },

  "image#volume": {
    "exec": "/home/me/niri-setup/waybar/scripts/volume-icon.sh",
    "size": 14,
    "interval": 2,
    "on-click": "/home/me/niri-setup/waybar/scripts/volume.sh",
    "on-click-middle": "pavucontrol",
    "on-scroll-down": "/home/me/niri-setup/scripts/set-volume.sh down",
    "on-scroll-up": "/home/me/niri-setup/scripts/set-volume.sh up"
  },

  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted",
    "on-click": "/home/me/niri-setup/waybar/scripts/volume.sh",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-down": "/home/me/niri-setup/scripts/set-volume.sh down",
    "on-scroll-up": "/home/me/niri-setup/scripts/set-volume.sh up",
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}\nLeft: Mixer | Right: Mute | Middle: pavucontrol"
  },

  "image#network": {
    "exec": "/home/me/niri-setup/waybar/scripts/network-icon.sh",
    "size": 14,
    "interval": 10,
    "on-click": "alacritty --title nmtui --config-file /home/me/niri-setup/alacritty/float.toml -e nmtui connect"
  },

  "image#clipboard": {
    "path": "/home/me/niri-setup/waybar/icons/clipboard.svg",
    "size": 14,
    "interval": 60,
    "tooltip": false,
    "on-click": "/home/me/niri-setup/waybar/scripts/clipboard.sh",
    "on-click-middle": "/home/me/niri-setup/scripts/clear-clipboard.sh"
  },

  "image#wallpaper": {
    "path": "/home/me/niri-setup/waybar/icons/wallpaper.svg",
    "size": 14,
    "interval": 60,
    "tooltip": false,
    "on-click": "/home/me/niri-setup/waybar/scripts/wallpaper-gallery.sh",
    "on-click-middle": "/home/me/niri-setup/scripts/change-wallpaper-simple.sh random",
    "on-scroll-up": "/home/me/niri-setup/scripts/change-wallpaper-simple.sh next",
    "on-scroll-down": "/home/me/niri-setup/scripts/change-wallpaper-simple.sh prev"
  },

  "image#settings": {
    "path": "/home/me/niri-setup/waybar/icons/settings.svg",
    "size": 14,
    "interval": 60,
    "tooltip": false,
    "on-click": "/home/me/niri-setup/waybar/scripts/settings.sh"
  },

  "group/battery": {
    "orientation": "horizontal",
    "modules": [
      "image#battery",
      "battery"
    ]
  },

  "image#battery": {
    "exec": "/home/me/niri-setup/waybar/scripts/battery-icon.sh",
    "size": 14,
    "interval": 30,
    "on-click": "alacritty --config-file /home/me/niri-setup/alacritty/float.toml -e btop"
  },

  "battery": {
    "interval": 30,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{capacity}%",
    "format-charging": "+{capacity}%",
    "tooltip-format": "Power: {power}W\nTime: {time}",
    "on-click": "alacritty --config-file /home/me/niri-setup/alacritty/float.toml -e btop"
  },

  "image#power": {
    "path": "/home/me/niri-setup/waybar/icons/power.svg",
    "size": 14,
    "interval": 60,
    "tooltip": false,
    "on-click": "/home/me/niri-setup/waybar/scripts/power-menu.sh",
    "on-click-middle": "/home/me/niri-setup/scripts/wlogout.sh"
  }
}
