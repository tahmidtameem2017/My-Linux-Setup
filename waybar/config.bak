{
  "layer": "top",
  "position": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 6,
  "modules-left": [
    "custom/logo",
    "niri/workspaces",
    "custom/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/media",
    "cpu",
    "memory",
    "pulseaudio",
    "battery",
    "network",
    "tray"
  ],
  "reload_style_on_change": true,

  "custom/window": {
    "format": "{}",
    "interval": 1,
    "exec": "python3 /home/me/niri-setup/waybar/modules/window_info.py",
    "return-type": "json"
  },

  "custom/logo": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "Arch Linux\nClick to open application launcher",
    "on-click": "fuzzel"
  },

  "niri/workspaces": {
    "format": "{index}",
    "on-click": "activate",
    "sort-by-number": true,
    "all-outputs": false,
    "active-only": false
  },

  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%d.%m.%Y | %H:%M}",
    "interval": 1,
    "tooltip-format": "<span font_size='large' font_weight='bold'>{:%A, %d %B %Y}</span>\n<span font_size='large'>{:%H:%M:%S}</span>",
    "on-click": "yad --calendar --title='Calendar' --fixed"
  },

  "cpu": {
    "interval": 1,
    "format": "󰍬 {usage}%",
    "on-click": "alacritty --config-file /home/me/niri-setup/alacritty/float.toml -e btop"
  },

  "memory": {
    "format": "󰘚 {percentage}%",
    "on-click": "alacritty --config-file /home/me/niri-setup/alacritty/float.toml -e btop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphones": "󰋋",
      "handsfree": "󰋋",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-down": "/home/me/niri-setup/scripts/set-volume.sh down",
    "on-scroll-up": "/home/me/niri-setup/scripts/set-volume.sh up"
  },

  "battery": {
    "interval": 1,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 20
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-icons": ["󰁹", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Power: {power}\nTime: {time}",
    "on-click": "alacritty --config-file /home/me/niri-setup/alacritty/float.toml -e btop"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "alacritty --title nmtui --config-file /home/me/niri-setup/alacritty/float.toml -e nmtui connect"
  },

  "custom/media": {
    "format": "{}",
    "return-type": "json",
    "max-length": 35,
    "exec": "python3 /home/me/niri-setup/waybar/modules/media-player.py 2> /dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "show-passive-items": true
  }
}
