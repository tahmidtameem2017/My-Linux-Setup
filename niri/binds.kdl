binds {
    // Applications
    Mod+Return      { spawn-sh "alacritty --config-file /home/me/niri-setup/alacritty/default.toml"; }
    // Mod+Ctrl+Return { spawn-sh "fuzzel --config /home/me/niri-setup/fuzzel/fuzzel.ini"; }
    Mod+Ctrl+Return { spawn-sh "qs -c sunset ipc call launcher toggle"; }
    // Alt+Space       { spawn-sh "walker"; }
    Alt+Space       { spawn-sh "qs -c sunset ipc call launcher toggle"; }
    Mod+B           { spawn-sh "/usr/bin/brave"; }
    Mod+E           { spawn-sh "thunar"; }
    Mod+L           { spawn-sh "/home/me/niri-setup/scripts/swaylock.sh"; }
    // Mod+C           { spawn-sh "copyq toggle"; }
    Mod+C           { spawn-sh "qs -c sunset ipc call clipboard toggle"; }
    Mod+Shift+C     { spawn-sh "/home/me/niri-setup/scripts/clear-clipboard.sh"; }
    Mod+Shift+D     { spawn-sh "/home/me/niri-setup/scripts/clipboard-delete-last.sh"; }
    Mod+Shift+V     { spawn-sh "/home/me/niri-setup/scripts/clipboard-save-image.sh"; }
    // Mod+I           { spawn-sh "/home/me/niri-setup/scripts/change-idle-time.sh"; }
    Mod+I           { spawn-sh "qs -c sunset ipc call settings toggle"; }
    // Mod+P           { spawn-sh "/home/me/niri-setup/scripts/change-power-profile.sh"; }
    Mod+P           { spawn-sh "qs -c sunset ipc call settings toggle"; }
    // System settings = GNOME Settings (scripts/gnome-settings.sh). It took
    // over from the native Settings Center popup on 2026-10-02; the old Xfce
    // manager and KDE systemsettings binds are gone so there is only ONE
    // settings app to learn. Mod+I/Mod+P stay on the fast bar popup
    // (quickshell `settings`); Mod+Shift+I lands straight on the Network
    // panel. Both scripts forward their argument to gnome-control-center.
    Mod+Shift+I     { spawn-sh "/home/me/niri-setup/scripts/gnome-settings.sh network"; }
    Mod+Shift+P     { spawn-sh "/home/me/niri-setup/scripts/gnome-settings.sh"; }
    Mod+U           { spawn-sh "alacritty --title 'Updater' --config-file /home/me/niri-setup/alacritty/float.toml -e /home/me/niri-setup/waybar/modules/install-updates.sh"; }
    Mod+Ctrl+W      { spawn-sh "alacritty --title 'Wallpaper Selector' --config-file /home/me/niri-setup/alacritty/float.toml -e /home/me/niri-setup/scripts/change-wallpaper.sh"; }
    Mod+Backspace   { spawn-sh "/home/me/niri-setup/scripts/wlogout.sh"; }
    Mod+Grave       { spawn-sh "/home/me/niri-setup/scripts/dropdown-terminal.sh"; }
    // Share via LocalSend
    Mod+S           { spawn-sh "localsend"; }
    Mod+Shift+S     { spawn-sh "/home/me/niri-setup/scripts/scroll-screenshot.sh"; }
    Mod+Shift+5     { spawn-sh "qs -c sunset ipc call capture toggle"; }
    Mod+N           { spawn-sh "dunstctl set-paused toggle && notify-send -a dunst 'Dunst' \"$(dunstctl is-paused && echo 'Do Not Disturb ON' || echo 'Do Not Disturb OFF')\""; }
    Mod+Ctrl+R      { spawn-sh "niri msg action reload-config"; }
    // Saved workspace sessions (study/entertainment/…): native editor popup.
    // Profiles live in ~/.local/share/niri-setup/sessions/*.json — the
    // niri config is never touched. Launcher also lists sessions by name.
    Mod+Shift+O      { spawn-sh "qs -c sunset ipc call sessions toggle"; }
    Mod+Ctrl+Shift+O { spawn-sh "obsidian"; }

    // Backlight and Audio
    // Brightness keys ping the sunset OSD (`qs ipc call osd brightness`)
    // so the % is visible even over fullscreen video (bar is hidden there).
    // Volume keys need no ping: Osd.qml watches AudioService reactively.
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl set +5%; qs -c sunset ipc call osd brightness" ; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl set 5%-; qs -c sunset ipc call osd brightness" ; }
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; qs -c sunset ipc call osd mic"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause        allow-when-locked=true { spawn-sh "playerctl pause"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }

    // Windows and Columns
    Mod+Q                { close-window; }
    Mod+T                { toggle-window-floating; }
    Mod+Shift+T          { toggle-column-tabbed-display; }
    Mod+M                { maximize-column; }
    Mod+F                { fullscreen-window; }
    Mod+Left             { focus-column-left; }
    Mod+Right            { focus-column-right; }
    Mod+Down             { focus-window-down; }
    Mod+Up               { focus-window-up; }
    Mod+H                { focus-column-left; }
    Mod+J                { focus-window-down; }
    Mod+K                { focus-window-up; }
    Mod+Shift+H          { focus-column-right; }
    Mod+Ctrl+Left        { move-column-left; }
    Mod+Ctrl+Right       { move-column-right; }
    Mod+Ctrl+Down        { move-window-down; }
    Mod+Ctrl+Up          { move-window-up; }
    Mod+Home             { focus-column-first; }
    Mod+End              { focus-column-last; }
    Mod+Ctrl+Home        { move-column-to-first; }
    Mod+Ctrl+End         { move-column-to-last; }
    Mod+Shift+Left       { set-column-width "-10%"; }
    Mod+Shift+Right      { set-column-width "+10%"; }
    Mod+Shift+Up         { set-window-height "-10%"; }
    Mod+Shift+Down       { set-window-height "+10%"; }
    Mod+BracketLeft      { consume-or-expel-window-left; }
    Mod+BracketRight     { consume-or-expel-window-right; }
    Mod+Comma            { consume-window-into-column; }
    Mod+Period           { expel-window-from-column; }

    // Workspaces
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+1              { focus-workspace 1; }
    Mod+2              { focus-workspace 2; }
    Mod+3              { focus-workspace 3; }
    Mod+4              { focus-workspace 4; }
    Mod+5              { focus-workspace 5; }
    Mod+6              { focus-workspace 6; }
    Mod+7              { focus-workspace 7; }
    Mod+8              { focus-workspace 8; }
    Mod+9              { focus-workspace 9; }
    Mod+0              { focus-workspace 10; }
    Mod+Ctrl+1         { move-column-to-workspace 1; }
    Mod+Ctrl+2         { move-column-to-workspace 2; }
    Mod+Ctrl+3         { move-column-to-workspace 3; }
    Mod+Ctrl+4         { move-column-to-workspace 4; }
    Mod+Ctrl+5         { move-column-to-workspace 5; }
    Mod+Ctrl+6         { move-column-to-workspace 6; }
    Mod+Ctrl+7         { move-column-to-workspace 7; }
    Mod+Ctrl+8         { move-column-to-workspace 8; }
    Mod+Ctrl+9         { move-column-to-workspace 9; }
    Mod+Ctrl+0         { move-column-to-workspace 10; }
    Mod+A              { toggle-overview; }

    // Screenshots
    Print       { screenshot; }
    Ctrl+Print  { screenshot-window; }
    Shift+Print { screenshot-screen; }
    Mod+Ctrl+S  { spawn-sh "/home/me/niri-setup/scripts/screenshot.sh"; }
    Mod+Shift+R { spawn-sh "/home/me/niri-setup/scripts/record-screen.sh"; }
}
