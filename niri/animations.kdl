// Subtle premium animations — calm, snappy, never bouncy.
// Springs (velocity-aware) for gesture-driven motion; eased timings for
// open/close. All motion settles in ~150-300ms so it reads as responsive.
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 250
        curve "cubic-bezier" 0.22 1 0.36 1
    }

    window-close {
        duration-ms 180
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // Perf: critically damped (ratio 1.0, no overshoot) so one-shot
    // notifications settle in minimum frames on weak iGPUs.
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.001
    }

    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.01
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
